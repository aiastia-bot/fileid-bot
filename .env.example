# ===== 数据库配置 =====
# 数据库类型：sqlite（默认）或 mysql
DB_TYPE=sqlite
# 数据库连接 URL（仅 DB_TYPE=mysql 时需要）
# 以下格式均可（程序会自动补全驱动前缀）:
#   user:password@localhost:3306/fileid_bot
#   mysql://user:password@localhost:3306/fileid_bot
#   mysql+aiomysql://user:password@localhost:3306/fileid_bot
DATABASE_URL=
# SQLite 数据库文件路径（默认 ./data/fileid.db）
DB_PATH=./data/fileid.db

# 主Bot Token（管理Bot，用于用户注册/管理自己的Bot）
BOT_TOKEN=你的主Bot_Token

# 管理员 Telegram ID（逗号分隔，可查看平台统计）
ADMIN_IDS=123456789

# 每个用户最多添加的Bot数量（默认1）
MAX_BOTS_PER_USER=1

# 用户购买 Telegram Premium 会员时 Bot 额外收取的服务费（单位：星星，默认100）
# 用户支付价 = 官方基础价(3个月1000/6个月1500/12个月2500) + 此服务费
PREMIUM_USER_MARKUP=100

# 代码前缀（留空则使用 Bot 用户名）
CODE_PREFIX=

# 用户访问模式：默认黑名单模式（blacklist）
# 黑名单用户将被禁止使用主Bot的所有功能
# 管理员使用 /blacklist 命令管理黑名单
# - /blacklist add <用户ID> [原因]  添加到黑名单
# - /blacklist del <用户ID>         从黑名单移除
# - /blacklist list                 查看黑名单
# - /blacklist check <用户ID>       检查用户状态

# ===== 发送限速与重试配置 =====
# 发送失败重试次数（默认3次）
SEND_RETRY_COUNT=3
# 重试基础延迟秒数，实际延迟 = delay × 2^重试次数（默认2秒）
SEND_RETRY_DELAY=2.0
# 每组发送之间的附加延迟秒数（默认0.05秒，主要节奏由统一限流控制）
SEND_BATCH_DELAY=0.05
# 单个文件发送之间的延迟秒数（默认0.5秒）
SEND_INDIVIDUAL_DELAY=0.5
# 单次请求最大发送文件数（默认30），超过则自动分批
SEND_MAX_FILES_PER_REQUEST=30
# 每 Bot 最小附加发送间隔（默认0，主要节奏由统一限流控制）
SEND_MIN_INTERVAL=0
# Telegram API 读取超时秒数（默认60秒）
API_READ_TIMEOUT=60.0
# Telegram API 写入超时秒数（默认60秒）
API_WRITE_TIMEOUT=60.0
# Telegram API 连接超时秒数（默认30秒）
API_CONNECT_TIMEOUT=30.0

# ===== Webhook 模式配置 =====
# Bot 运行模式：polling（默认）或 webhook
BOT_MODE=polling
# Webhook 外部域名（不含 https://），如 bots.example.com
WEBHOOK_HOST=
# Webhook 本地监听端口（默认8080）
WEBHOOK_PORT=8080
# Webhook URL 基路径（默认 /webhook）
WEBHOOK_PATH=/webhook
# Webhook secret token（可选，用于验证请求来源）
WEBHOOK_SECRET=

# 群组支持（默认 false，仅允许私聊）
ALLOW_GROUP=false

# ===== 日志配置 =====
# 日志级别：DEBUG（全部）、INFO（一般信息）、WARNING（警告+错误，推荐日常）、ERROR（仅错误）
# 日常运行推荐 WARNING，排查问题时改为 INFO 或 DEBUG
LOG_LEVEL=WARNING

# ===== 容器时区配置 =====
# 容器时区（影响 datetime.now()、created_at、"今日新增" 统计）
# 默认 Asia/Shanghai（UTC+8），如需其他时区可在此修改
TZ=Asia/Shanghai

# ===== 分布式架构配置 =====
# 节点角色：standalone（单机，默认）/ master（主控节点）/ worker（工作节点）
# standalone: 单机运行，和之前一样
# master: 主控节点，运行主Bot + 调度器，分配Bot到Worker
# worker: 工作节点，只运行用户Bot，接收Master指令
ROLE=standalone

# Master 节点地址（Worker 模式必填，如 http://master:8080 或 https://1.1.1.1:8080）
MASTER_URL=

# Worker 节点标识（每个 Worker 唯一，如 worker-1, worker-2）
NODE_ID=local

# 内部通信密钥（Master 和 Worker 必须一致，用于 API 鉴权）
WORKER_SECRET=

# Worker 内部 API 端口（默认 8081）
WORKER_PORT=8081

# 每个 Worker 最大 Bot 数量（默认 100）
MAX_BOTS_PER_WORKER=100

# Worker 健康检查间隔秒数（默认 60）
HEALTH_CHECK_INTERVAL=60

# Worker 自身对外 Webhook 域名（Worker 模式下需要配置，如 node1.example.com）
WORKER_WEBHOOK_HOST=


# ===== Redis 配置（可选） =====
# 不配置时使用内存降级方案（单节点可用，多节点建议配置）
REDIS_URL=
# 限流窗口秒数（默认60）
RATE_LIMIT_WINDOW=60
# 窗口内最大请求数（默认30）
RATE_LIMIT_MAX=30
# 限流排队最大等待秒数（默认10）
RATE_LIMIT_MAX_WAIT=10
# 单次 RetryAfter 最大等待秒数（默认30），超过则放弃让 Telegram 重试（防止 499）
RETRY_AFTER_MAX_WAIT=30.0

# ===== 全局 API 限速配置 =====
# 每 Bot 所有 API 调用的最小间隔（秒），包括 send/edit/answer 等所有操作
# 默认 0.2 秒 → 每 Bot 最大 5 次 API 调用/秒
# Telegram 限制约 30 次/秒，0.2s 间隔留足余量
# 多 Bot 场景下每个 Bot 独立限速，互不影响
BOT_MIN_API_INTERVAL=0.2

# ===== 可靠性与运维（升级后新增） =====
# Webhook 模式必须设置 WEBHOOK_SECRET：16-256 位字母、数字、下划线或短横线。
# Master/Worker 模式必须设置相同的 WORKER_SECRET。
# Worker 可供 Master 访问的内部地址（每个节点不同）
WORKER_URL=
# 同时处理的消息数；同一用户会话保持顺序
INBOX_WORKERS=4
INBOX_MAX_ATTEMPTS=8
SEND_QUEUE_MAX_PENDING=2000
SEND_QUEUE_MAX_PER_USER=100
SEND_QUEUE_MAX_RETRIES=3
# 成功/取消任务的保留天数，失败任务及支付账本不自动删除
DATA_RETENTION_DAYS=30
# retain：兼容旧版，超额仍保存但不返回代码；reject：超额拒绝新增
FILE_QUOTA_POLICY=retain
# Docker 默认只绑定本机，供同机反代访问
BIND_HOST=127.0.0.1

# ===== 级联备份 =====
# 总开关：用户在主 Bot 用 /backup 配置「A→B，B 分发到 C/D」的备份树
BACKUP_ENABLED=1
# 备份 Bot 的分发宽度（主 Bot 固定只推给 1 个，负载集中在备份层）
BACKUP_FANOUT=2
# 补位检查周期秒数：Bot 失效后在这个时间内自动重建链路并通知主人
BACKUP_RECONCILE_INTERVAL=60

# ===== 死亡 Bot 自动清理 =====
# Token 被撤销/被删除/被封禁超过 N 天后，自动清理其文件记录并移出备份组
# （宽限期内主人 /updatetoken 恢复即可取消清理；0 = 禁用，仅手动 /purge）
AUTO_PURGE_DEAD_BOT_DAYS=1


# ===== 统一 Telegram API 限流 =====
# 所有直接/封装 API 调用共享同一个 Bot 的预算，既有 BOT_MIN_API_INTERVAL 继续有效。
# 消息预算按文件条数计，相册不会只算一次；这些是起始配置，不保证消除全部429。
API_MESSAGES_PER_SECOND=20
API_PRIVATE_INTERVAL=1.1
API_GROUP_INTERVAL=3.2
# 同一消息的进度编辑最小间隔
API_EDIT_INTERVAL=2.0
# 不同聊天允许网络请求并行，但每个请求仍须通过速率与冷却检查
API_MAX_INFLIGHT=8
# 429 只由统一入口重试，次数不和发送包装器/队列相乘
API_429_RETRIES=2
API_429_JITTER=0.2
